{
	"name": "llm-chat-cli",
	"version": "0.0.0",
	"license": "MIT",
	"bin": "dist/cli.js",
	"type": "module",
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "babel --out-dir=dist source && chmod +x dist/cli.js",
		"dev": "babel --out-dir=dist --watch source",
		"test": "prettier --check . && xo && ava"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"ink": "^6.5.1",
		"ink-text-input": "^6.0.0",
		"meow": "^14.0.0",
		"node-fetch": "^3.3.2",
		"openai": "^6.9.1",
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@babel/cli": "^7.28.3",
		"@babel/preset-react": "^7.28.5",
		"@vdemedes/prettier-config": "^2.0.1",
		"ava": "^6.4.1",
		"chalk": "^5.6.2",
		"eslint-config-xo-react": "^0.29.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"import-jsx": "^5.0.0",
		"ink-testing-library": "^4.0.0",
		"prettier": "^3.7.1",
		"xo": "^1.2.3"
	},
	"ava": {
		"environmentVariables": {
			"NODE_NO_WARNINGS": "1"
		},
		"nodeArguments": [
			"--loader=import-jsx"
		]
	},
	"xo": {
		"extends": "xo-react",
		"prettier": true,
		"rules": {
			"react/prop-types": "off"
		}
	},
	"prettier": "@vdemedes/prettier-config",
	"babel": {
		"presets": [
			"@babel/preset-react"
		]
	}
}
